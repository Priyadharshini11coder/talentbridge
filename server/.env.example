# Server Port (Render sets PORT automatically, default: 5000)
PORT=5000

# MongoDB Connection String (Atlas URI or local daemon)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/talentbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/talentbridge

# JWT Encryption Secret Key
JWT_SECRET=talentbridge_production_jwt_secret_change_in_prod_2026

# Allowed Frontend URL(s) for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app)
FRONTEND_URL=https://talentbridge.vercel.app,http://localhost:5173

# Node Environment
NODE_ENV=production
